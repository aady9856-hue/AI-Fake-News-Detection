@model IEnumerable<FakeNewsDetection.Models.NewsArticle>

@{
ViewData["Title"] = "Analysis History";

var articleList =
    Model?.ToList()
    ?? new List<FakeNewsDetection.Models.NewsArticle>();

int totalCount = articleList.Count;

int realCount =
    articleList.Count(a =>
        string.Equals(
            a.Prediction?.Trim(),
            "REAL",
            StringComparison.OrdinalIgnoreCase));

int fakeCount =
    articleList.Count(a =>
        string.Equals(
            a.Prediction?.Trim(),
            "FAKE",
            StringComparison.OrdinalIgnoreCase));

}

<style>
    .history-page {
        padding: 4rem 0 5rem;
    }

    .history-header h1 {
        font-weight: 800;
        letter-spacing: -0.8px;
    }

    .history-header p {
        max-width: 720px;
    }

    .stat-card {
        border: none;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 0.5rem 1.5rem rgba(15, 23, 42, 0.07);
        padding: 1.25rem;
        height: 100%;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.8rem;
        background: #eef2ff;
        font-size: 1.4rem;
    }

    .stat-number {
        font-size: 1.7rem;
        font-weight: 800;
        line-height: 1;
    }

    .stat-label {
        color: #64748b;
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .history-card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 0.75rem 2rem rgba(15, 23, 42, 0.08);
        background: #fff;
    }

    .search-card {
        border: none;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 0.5rem 1.5rem rgba(15, 23, 42, 0.06);
    }

    .filter-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: #475569;
        margin-bottom: 0.4rem;
    }

    .history-search-input,
    .history-filter-select {
        border-radius: 0.75rem;
    }

    .history-table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .history-table {
        margin-bottom: 0;
        min-width: 1100px;
    }

    .history-table thead th {
        white-space: nowrap;
        font-size: 0.82rem;
        font-weight: 700;
        color: #475569;
    }

    .history-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .history-table tbody tr:hover {
        background-color: #f8fafc;
    }

    .headline-cell {
        min-width: 280px;
        max-width: 420px;
    }

    .explanation-cell {
        min-width: 280px;
        max-width: 380px;
    }

    .headline-text {
        font-weight: 650;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .explanation-text {
        color: #64748b;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .prediction-badge {
        min-width: 70px;
        text-align: center;
        font-size: 0.75rem;
        padding: 0.45rem 0.65rem;
    }

    .confidence-value {
        font-weight: 700;
        white-space: nowrap;
    }

    .confidence-progress {
        height: 5px;
        width: 90px;
        border-radius: 10px;
        overflow: hidden;
    }

    .action-column {
        min-width: 190px;
    }

    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .action-buttons .btn {
        min-height: 36px;
    }

    .delete-button {
        min-width: 90px;
    }

    .empty-state {
        padding: 5rem 1.5rem;
        text-align: center;
    }

    .empty-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
    }

    .success-alert,
    .error-alert,
    .history-disclaimer {
        border: none;
        border-radius: 0.8rem;
    }

    .no-results-message {
        padding: 1rem;
        border-radius: 0.75rem;
        background: #f8fafc;
    }

    /* Tablet */
    @@media (max-width: 991.98px) {
        .history-page {
            padding: 3rem 0 4rem;
        }

        .history-header h1 {
            font-size: 2rem;
        }

        .history-header p {
            font-size: 1rem !important;
        }

        .stat-number {
            font-size: 1.5rem;
        }
    }

    /* Mobile */
    @@media (max-width: 767.98px) {
        .history-page {
            padding: 2rem 0 3rem;
        }

        .history-header {
            margin-bottom: 1.5rem !important;
        }

        .history-header h1 {
            font-size: 1.75rem;
            letter-spacing: -0.5px;
        }

        .history-header p {
            font-size: 0.95rem !important;
            line-height: 1.55;
        }

        .history-header .btn {
            width: 100%;
            min-height: 48px;
        }

        .stat-card {
            padding: 1rem;
        }

        .stat-icon {
            width: 44px;
            height: 44px;
            flex-basis: 44px;
            font-size: 1.2rem;
        }

        .stat-number {
            font-size: 1.4rem;
        }

        .stat-label {
            font-size: 0.78rem;
        }

        .search-card {
            border-radius: 0.9rem;
        }

        .search-card .card-body {
            padding: 1rem !important;
        }

        .history-search-input,
        .history-filter-select {
            min-height: 48px;
            font-size: 1rem;
        }

        .history-card {
            border-radius: 0.9rem;
        }

        .history-table {
            min-width: 1000px;
        }

        .history-table thead th,
        .history-table tbody td {
            padding-top: 0.9rem;
            padding-bottom: 0.9rem;
        }

        .headline-cell {
            min-width: 240px;
        }

        .explanation-cell {
            min-width: 250px;
        }

        .action-column {
            min-width: 180px;
        }

        .action-buttons {
            flex-direction: column;
            align-items: stretch;
        }

        .action-buttons .btn,
        .action-buttons form,
        .action-buttons form button {
            width: 100%;
        }

        .empty-state {
            padding: 3.5rem 1rem;
        }

        .empty-icon {
            font-size: 3rem;
        }

        .history-disclaimer {
            font-size: 0.85rem;
            line-height: 1.55;
        }
    }

    /* Very small phones */
    @@media (max-width: 380px) {
        .history-page {
            padding-top: 1.5rem;
        }

        .history-header h1 {
            font-size: 1.55rem;
        }

        .stat-card {
            padding: 0.9rem;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            flex-basis: 40px;
        }

        .stat-number {
            font-size: 1.25rem;
        }

        .stat-label {
            font-size: 0.74rem;
        }
    }
    /* =========================================
   DARK MODE
   ========================================= */

html[data-theme="dark"] .history-card,
html[data-theme="dark"] .search-card,
html[data-theme="dark"] .stat-card {
    background-color: #1f2937 !important;
    color: #f3f4f6;
}

html[data-theme="dark"] .history-page h1,
html[data-theme="dark"] .history-page h2,
html[data-theme="dark"] .history-page h3,
html[data-theme="dark"] .history-page h4,
html[data-theme="dark"] .history-page h5 {
    color: #f3f4f6;
}

html[data-theme="dark"] .history-page .text-muted {
    color: #9ca3af !important;
}

/* Search / Filter */

html[data-theme="dark"] .search-card .form-control,
html[data-theme="dark"] .search-card .form-select {
    background-color: #111827;
    color: #f3f4f6;
    border-color: #4b5563;
}

html[data-theme="dark"] .search-card .form-control::placeholder {
    color: #9ca3af;
}

html[data-theme="dark"] .search-card .form-control:focus,
html[data-theme="dark"] .search-card .form-select:focus {
    background-color: #111827;
    color: #ffffff;
    border-color: #0d6efd;
}

/* History Table */

html[data-theme="dark"] .history-card .table {
    --bs-table-bg: #1f2937;
    --bs-table-color: #f3f4f6;
    --bs-table-border-color: #374151;
}

html[data-theme="dark"] .history-card .table-light {
    --bs-table-bg: #111827;
    --bs-table-color: #f3f4f6;
}

html[data-theme="dark"] .history-card .table-hover > tbody > tr:hover > * {
    --bs-table-accent-bg: #374151;
    color: #ffffff;
}

/* Empty state */

html[data-theme="dark"] .history-page .no-results-message {
    color: #f3f4f6;
}

/* Borders */

html[data-theme="dark"] .history-page hr,
html[data-theme="dark"] .history-page .border-top,
html[data-theme="dark"] .history-page .border-bottom {
    border-color: #374151 !important;
}

/* Delete confirmation / alerts */

html[data-theme="dark"] .history-page .alert {
    border-color: #374151;
}
</style>

<div class="history-page">
    <div class="container">

```
    <!-- Header -->
    <div class="history-header mb-4">
        <div class="d-flex flex-column flex-md-row
                    justify-content-between
                    align-items-md-center
                    gap-3">

            <div>
                <h1 class="mb-2">
                    Analysis History
                </h1>

                <p class="text-muted fs-5 mb-0">
                    Review previously analyzed news articles
                    and their AI predictions.
                </p>
            </div>

            <a asp-controller="News"
               asp-action="Check"
               class="btn btn-primary btn-lg text-nowrap">
                🔍 Check New News
            </a>
        </div>
    </div>

    <!-- Success / Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success success-alert shadow-sm mb-4"
             role="alert">

            <strong>✅ Success:</strong>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger error-alert shadow-sm mb-4"
             role="alert">

            <strong>⚠️ Error:</strong>
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!articleList.Any())
    {
        <!-- Empty State -->
        <div class="card history-card">
            <div class="empty-state">

                <div class="empty-icon">
                    📭
                </div>

                <h3 class="fw-bold">
                    No Analysis History
                </h3>

                <p class="text-muted mb-4">
                    You haven't analyzed any news articles yet.
                    Your previous analyses will appear here.
                </p>

                <a asp-controller="News"
                   asp-action="Check"
                   class="btn btn-primary btn-lg px-4">
                    🚀 Analyze Your First Article
                </a>

            </div>
        </div>
    }
    else
    {
        <!-- Statistics -->
        <div class="row g-3 mb-4">

            <!-- Total -->
            <div class="col-12 col-sm-4">
                <div class="stat-card">
                    <div class="d-flex align-items-center gap-3">

                        <div class="stat-icon">
                            📊
                        </div>

                        <div>
                            <div class="stat-number">
                                @totalCount
                            </div>

                            <div class="stat-label">
                                Total Analyses
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Real -->
            <div class="col-12 col-sm-4">
                <div class="stat-card">
                    <div class="d-flex align-items-center gap-3">

                        <div class="stat-icon">
                            ✅
                        </div>

                        <div>
                            <div class="stat-number text-success">
                                @realCount
                            </div>

                            <div class="stat-label">
                                Real Predictions
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Fake -->
            <div class="col-12 col-sm-4">
                <div class="stat-card">
                    <div class="d-flex align-items-center gap-3">

                        <div class="stat-icon">
                            🚫
                        </div>

                        <div>
                            <div class="stat-number text-danger">
                                @fakeCount
                            </div>

                            <div class="stat-label">
                                Fake Predictions
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!-- Search / Filter -->
        <div class="card search-card mb-4">

            <div class="card-body p-4">

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-8">

                        <label for="historySearchInput"
                               class="filter-label">
                            Search Articles
                        </label>

                        <input type="text"
                               id="historySearchInput"
                               class="form-control form-control-lg history-search-input"
                               placeholder="Search by headline or explanation..."
                               autocomplete="off" />

                    </div>

                    <div class="col-12 col-md-4">

                        <label for="historyFilterSelect"
                               class="filter-label">
                            Prediction
                        </label>

                        <select id="historyFilterSelect"
                                class="form-select form-select-lg history-filter-select">

                            <option value="ALL">
                                All Predictions
                            </option>

                            <option value="REAL">
                                ✅ Real
                            </option>

                            <option value="FAKE">
                                🚫 Fake
                            </option>

                        </select>

                    </div>

                </div>

            </div>
        </div>

        <!-- History Table -->
        <div class="card history-card">

            <div class="history-table-wrapper">

                <table class="table table-hover align-middle history-table"
                       id="historyTable">

                    <thead class="table-light">
                        <tr>

                            <th class="px-4 py-3">
                                News Article
                            </th>

                            <th class="py-3">
                                Prediction
                            </th>

                            <th class="py-3">
                                Confidence
                            </th>

                            <th class="py-3">
                                Analyzed On
                            </th>

                            <th class="py-3">
                                Explanation
                            </th>

                            <th class="py-3 pe-4 action-column">
                                Actions
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var article in articleList)
                        {
                            string prediction =
                                article.Prediction?
                                    .Trim()
                                    .ToUpperInvariant()
                                ?? "FAKE";

                            bool isReal =
                                prediction == "REAL";

                            string badgeClass =
                                isReal
                                    ? "bg-success"
                                    : "bg-danger";

                            double confidence =
                                article.Confidence ?? 0.0;

                            if (confidence < 0)
                            {
                                confidence = 0;
                            }

                            if (confidence > 100)
                            {
                                confidence = 100;
                            }

                            string searchText =
                                $"{article.Headline} {article.Explanation}"
                                .ToLowerInvariant();

                            <tr data-prediction="@prediction"
                                data-search="@searchText">

                                <!-- Headline -->
                                <td class="px-4 headline-cell">

                                    <div class="headline-text">
                                        @(string.IsNullOrWhiteSpace(article.Headline)
                                            ? "No headline"
                                            : article.Headline)
                                    </div>

                                </td>

                                <!-- Prediction -->
                                <td>

                                    <span class="badge @badgeClass prediction-badge">
                                        @(isReal ? "REAL" : "FAKE")
                                    </span>

                                </td>

                                <!-- Confidence -->
                                <td>

                                    <div class="confidence-value">
                                        @confidence.ToString("0.##")%
                                    </div>

                                    <div class="progress mt-2 confidence-progress">

                                        <div class="progress-bar @(isReal ? "bg-success" : "bg-danger")"
                                             style="width: @confidence.ToString("0.##")%;">
                                        </div>

                                    </div>

                                </td>

                                <!-- Date -->
                                <td class="text-nowrap">

                                    <span class="text-muted">
                                        @article.CreatedAt
                                            .ToLocalTime()
                                            .ToString("g")
                                    </span>

                                </td>

                                <!-- Explanation -->
                                <td class="pe-4 explanation-cell">

                                    <div class="explanation-text text-truncate"
                                         title="@article.Explanation">

                                        @(string.IsNullOrWhiteSpace(article.Explanation)
                                            ? "No explanation available."
                                            : article.Explanation)

                                    </div>

                                </td>

                                <!-- Actions -->
                                <td class="pe-4 action-column">

                                    <div class="action-buttons">

                                        <!-- View Result -->
                                        <a asp-controller="News"
                                           asp-action="Result"
                                           asp-route-id="@article.Id"
                                           class="btn btn-outline-primary btn-sm">

                                            👁️ View
                                        </a>

                                        <!-- Delete -->
                                        <form asp-controller="News"
                                              asp-action="Delete"
                                              asp-route-id="@article.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirmDelete();">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm delete-button">

                                                🗑️ Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

        <!-- No Search Results -->
        <div class="no-results-message text-muted small text-center mt-3"
             id="historyNoResultsMessage"
             style="display: none;">

            No analyses match your search or filter.

        </div>

        <!-- Disclaimer -->
        <div class="alert alert-warning history-disclaimer mt-4 mb-0"
             role="alert">

            <strong>⚠️ Note:</strong>

            These predictions are AI-assisted and should not be treated
            as absolute proof that a news article is true or false.

        </div>
    }

</div>
```

</div>

@section Scripts
{ <script>
(function () {

```
        const searchInput =
            document.getElementById("historySearchInput");

        const filterSelect =
            document.getElementById("historyFilterSelect");

        const tableBody =
            document.querySelector("#historyTable tbody");

        const noResultsMessage =
            document.getElementById(
                "historyNoResultsMessage");

        if (!searchInput ||
            !filterSelect ||
            !tableBody ||
            !noResultsMessage) {
            return;
        }

        function applyFilters() {

            const searchTerm =
                searchInput.value
                    .trim()
                    .toLowerCase();

            const selectedPrediction =
                filterSelect.value;

            const rows =
                tableBody.querySelectorAll("tr");

            let visibleCount = 0;

            rows.forEach(function (row) {

                const searchData =
                    row.getAttribute(
                        "data-search") || "";

                const rowPrediction =
                    row.getAttribute(
                        "data-prediction") || "";

                const matchesSearch =
                    searchData.includes(
                        searchTerm);

                const matchesFilter =
                    selectedPrediction === "ALL" ||
                    rowPrediction ===
                    selectedPrediction;

                if (matchesSearch &&
                    matchesFilter) {

                    row.style.display = "";
                    visibleCount++;
                }
                else {
                    row.style.display = "none";
                }
            });

            noResultsMessage.style.display =
                visibleCount === 0
                    ? ""
                    : "none";
        }

        searchInput.addEventListener(
            "input",
            applyFilters);

        filterSelect.addEventListener(
            "change",
            applyFilters);

    })();

    function confirmDelete() {

        return confirm(
            "Are you sure you want to delete this analysis?\n\n" +
            "This action cannot be undone."
        );
    }
</script>
```

