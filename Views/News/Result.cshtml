@model FakeNewsDetection.Models.NewsArticle

@{
    ViewData["Title"] = "Analysis Result";

    string prediction = Model?.Prediction?.Trim().ToUpperInvariant() ?? "FAKE";

    bool isReal = prediction == "REAL";

    string resultClass = isReal ? "result-real" : "result-fake";

    string resultIcon = isReal ? "✓" : "!";

    string resultTitle = isReal ? "REAL NEWS" : "FAKE NEWS";

    string resultMessage = isReal
        ? "The AI analysis indicates that this article appears to be real."
        : "The AI analysis indicates that this article appears to be fake or misleading.";

    double confidenceValue = Model?.Confidence ?? 0.0;

    if (confidenceValue < 0)
    {
        confidenceValue = 0;
    }

    if (confidenceValue > 100)
    {
        confidenceValue = 100;
    }

    var searchResults =
        ViewBag.NewsSearchResults
        as List<FakeNewsDetection.Services.NewsSearchResult>
        ?? new List<FakeNewsDetection.Services.NewsSearchResult>();
}

<style>

    /* =========================================
       RESULT PAGE
       ========================================= */

    .result-page {
        padding: 4rem 0 5rem;
        overflow-x: hidden;
    }

    .result-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .result-header h1 {
        font-weight: 800;
        letter-spacing: -0.8px;
    }

    .result-header p {
        max-width: 680px;
        margin: 0.75rem auto 0;
    }

    .result-card {
        border: none;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 1rem 3rem rgba(15, 23, 42, 0.1);
    }

    .result-banner {
        padding: 2.5rem 2rem;
        text-align: center;
        color: #fff;
    }

    .result-real {
        background: linear-gradient(135deg, #047857, #10b981);
    }

    .result-fake {
        background: linear-gradient(135deg, #b91c1c, #ef4444);
    }

    .result-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.18);
        border: 2px solid rgba(255, 255, 255, 0.35);
        font-size: 2.5rem;
        font-weight: 800;
    }

    .result-title {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .result-message {
        margin: 0 auto;
        max-width: 600px;
        color: rgba(255, 255, 255, 0.9);
    }

    /* =========================================
       CONFIDENCE
       ========================================= */

    .confidence-box {
        background: #f8fafc;
        border-radius: 1rem;
        padding: 1.5rem;
        height: 100%;
    }

    .confidence-number {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1;
    }

    .confidence-label {
        color: #64748b;
        font-size: 0.9rem;
        margin-top: 0.4rem;
    }

    /* =========================================
       DETAILS
       ========================================= */

    .detail-card {
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        padding: 1.5rem;
        height: 100%;
        background: #fff;
    }

    .detail-label {
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .article-content {
        max-height: 240px;
        overflow-y: auto;
        overflow-wrap: anywhere;
        background: #f8fafc;
        border-radius: 0.75rem;
        padding: 1rem;
        line-height: 1.7;
        white-space: pre-line;
    }

    .explanation-box {
        background: #f8fafc;
        border-left: 4px solid #2563eb;
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .source-link {
        word-break: break-all;
        overflow-wrap: anywhere;
    }

    /* =========================================
       SOURCES
       ========================================= */

    .sources-section {
        margin-top: 2rem;
    }

    .sources-header {
        margin-bottom: 1rem;
    }

    .source-card {
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        padding: 1.25rem;
        background: #fff;
        height: 100%;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .source-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.75rem 1.5rem rgba(15, 23, 42, 0.08);
    }

    .source-name {
        font-size: 0.8rem;
        font-weight: 800;
        color: #2563eb;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .source-title {
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.4;
        margin-top: 0.5rem;
        overflow-wrap: anywhere;
    }

    .source-description {
        color: #64748b;
        font-size: 0.9rem;
        line-height: 1.6;
        margin-top: 0.75rem;
        overflow-wrap: anywhere;
    }

    .source-date {
        color: #94a3b8;
        font-size: 0.8rem;
    }

    .source-read-button {
        margin-top: 1rem;
    }

    .no-sources {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 1rem;
        padding: 2rem;
        text-align: center;
        color: #64748b;
    }

    /* =========================================
       ACTION BUTTONS
       ========================================= */

    .action-buttons {
        margin-top: 2rem;
    }

    .action-buttons .btn {
        min-height: 50px;
    }

    .pdf-button {
        box-shadow: 0 0.5rem 1rem rgba(220, 53, 69, 0.18);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .pdf-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.75rem 1.5rem rgba(220, 53, 69, 0.25);
    }


    /* =========================================
       TABLET
       ========================================= */

    @@media (max-width: 991.98px) {

        .result-page {
            padding-top: 2.5rem;
        }

        .result-card .card-body {
            padding: 1.75rem !important;
        }

        .result-title {
            font-size: 1.8rem;
        }

        .detail-card {
            padding: 1.25rem;
        }
    }


    /* =========================================
       MOBILE
       ========================================= */

    @@media (max-width: 575.98px) {

        .result-page {
            padding-top: 1.25rem;
            padding-bottom: 2rem;
        }

        .result-header {
            margin-bottom: 1.5rem;
        }

        .result-header h1 {
            font-size: 1.65rem;
        }

        .result-header p {
            font-size: 0.9rem !important;
            line-height: 1.5;
        }

        /* Result banner */

        .result-banner {
            padding: 2rem 1.15rem;
        }

        .result-icon {
            width: 64px;
            height: 64px;
            font-size: 2rem;
        }

        .result-title {
            font-size: 1.5rem;
        }

        .result-message {
            font-size: 0.88rem;
            line-height: 1.5;
        }

        /* Main body */

        .result-card .card-body {
            padding: 1.15rem !important;
        }

        /* Headline */

        .detail-card h4 {
            font-size: 1.05rem;
            line-height: 1.5;
        }

        /* Confidence */

        .confidence-box {
            padding: 1.15rem;
        }

        .confidence-number {
            font-size: 2rem;
        }

        .confidence-label {
            font-size: 0.82rem;
        }

        /* Details */

        .detail-card {
            padding: 1.1rem;
        }

        .detail-label {
            font-size: 0.7rem;
        }

        .article-content {
            max-height: 300px;
            padding: 0.9rem;
            font-size: 0.9rem;
            line-height: 1.65;
        }

        .explanation-box {
            padding: 0.9rem 1rem;
            font-size: 0.9rem;
            line-height: 1.65;
        }

        /* Sources */

        .sources-section {
            margin-top: 1.25rem;
        }

        .sources-header h4 {
            font-size: 1.1rem;
        }

        .sources-header p {
            font-size: 0.85rem;
            line-height: 1.5;
        }

        .source-card {
            padding: 1rem;
        }

        .source-title {
            font-size: 0.98rem;
        }

        .source-description {
            font-size: 0.85rem;
        }

        .source-read-button {
            width: 100%;
            margin-top: 0.5rem;
        }

        /* Actions */

        .action-buttons {
            margin-top: 1.25rem;
            gap: 0.75rem !important;
        }

        .action-buttons .btn {
            width: 100%;
            min-height: 50px;
        }

        /* Disclaimer */

        .result-card .alert {
            font-size: 0.82rem;
            line-height: 1.5;
        }

        /* Analysis date */

        .analysis-date {
            font-size: 0.8rem;
            line-height: 1.5;
        }
    }
    /* =========================================
   DARK MODE
   ========================================= */

html[data-theme="dark"] .result-card,
