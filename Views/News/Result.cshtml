<div class="container">

    @if (Model == null)
    {
        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="alert alert-warning shadow-sm"
                     role="alert">

                    <h5 class="fw-bold">
                        No Result Available
                    </h5>

                    <p class="mb-3">
                        No analysis result was found.
                        Please submit a news article again.
                    </p>

                    <a asp-controller="News"
                       asp-action="Check"
                       class="btn btn-primary">

                        Check News

                    </a>

                </div>

            </div>

        </div>
    }
    else
    {

        <!-- =====================================
             PAGE HEADING
             ===================================== -->

        <div class="result-header">

            <h1>
                Analysis Result
            </h1>

            <p class="text-muted fs-5">
                AI-assisted analysis of the submitted news article.
            </p>

        </div>


        <!-- =====================================
             MAIN RESULT
             ===================================== -->

        <div class="row justify-content-center">

            <div class="col-lg-9 col-xl-8">

                <div class="result-card">

                    <!-- RESULT BANNER -->

                    <div class="result-banner @resultClass">

                        <div class="result-icon">
                            @resultIcon
                        </div>

                        <div class="result-title">
                            @resultTitle
                        </div>

                        <p class="result-message">
                            @resultMessage
                        </p>

                    </div>


                    <!-- RESULT CONTENT -->

                    <div class="card-body p-4 p-md-5">

                        <!-- HEADLINE -->

                        <div class="mb-4">

                            <div class="detail-label">
                                News Headline
                            </div>

                            <h4 class="fw-bold mb-0">

                                @(string.IsNullOrWhiteSpace(Model.Headline)
                                    ? "No headline provided."
                                    : Model.Headline)

                            </h4>

                        </div>


                        <!-- CONFIDENCE -->

                        <div class="row g-3 mb-4">

                            <div class="col-md-4">

                                <div class="confidence-box text-center">

                                    <div class="confidence-number">
                                        @confidenceValue.ToString("0.##")%
                                    </div>

                                    <div class="confidence-label">
                                        AI Confidence
                                    </div>

                                </div>

                            </div>


                            <div class="col-md-8">

                                <div class="confidence-box">

                                    <div class="d-flex justify-content-between
                                                align-items-center
                                                mb-2">

                                        <span class="fw-semibold">
                                            Confidence Level
                                        </span>

                                        <span class="fw-bold">
                                            @confidenceValue.ToString("0.##")%
                                        </span>

                                    </div>

                                    <div class="progress"
                                         style="height: 1rem;"
                                         role="progressbar"
                                         aria-valuenow="@confidenceValue"
                                         aria-valuemin="0"
                                         aria-valuemax="100">

                                        <div class="progress-bar @(isReal ? "bg-success" : "bg-danger")"
                                             style="width: @confidenceValue.ToString("0.##")%;">
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- AI EXPLANATION -->

                        <div class="detail-card mb-4">

                            <div class="detail-label">
                                AI Explanation
                            </div>

                            <div class="explanation-box">

                                @(string.IsNullOrWhiteSpace(Model.Explanation)
                                    ? "No explanation was provided for this analysis."
                                    : Model.Explanation)

                            </div>

                        </div>


                        <!-- ARTICLE CONTENT -->

                        <div class="detail-card mb-4">

                            <div class="detail-label">
                                Article Content
                            </div>

                            <div class="article-content">

                                @(string.IsNullOrWhiteSpace(Model.ArticleContent)
                                    ? "No article content was provided."
                                    : Model.ArticleContent)

                            </div>

                        </div>


                        <!-- SOURCE URL -->

                        @if (!string.IsNullOrWhiteSpace(Model.Url))
                        {
                            <div class="detail-card mb-4">

                                <div class="detail-label">
                                    Source URL
                                </div>

                                <a href="@Model.Url"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="source-link">

                                    @Model.Url

                                </a>

                            </div>
                        }


                        <!-- OTHER SOURCES -->

                        <div class="sources-section">

                            <div class="detail-card">

                                <div class="sources-header">

                                    <div class="detail-label">
                                        News Verification
                                    </div>

                                    <h4 class="fw-bold mb-1">
                                        🔎 Other Sources Found
                                    </h4>

                                    <p class="text-muted mb-0">
                                        These news sources were found
                                        using the submitted headline.
                                    </p>

                                </div>


                                @if (searchResults.Count > 0)
                                {
                                    <div class="row g-3">

                                        @foreach (var source in searchResults)
                                        {
                                            <div class="col-12">

                                                <div class="source-card">

                                                    <div class="source-name">

                                                        @(string.IsNullOrWhiteSpace(source.SourceName)
                                                            ? "Unknown Source"
                                                            : source.SourceName)

                                                    </div>


                                                    <div class="source-title">

                                                        @(string.IsNullOrWhiteSpace(source.Title)
                                                            ? "No headline available."
                                                            : source.Title)

                                                    </div>


                                                    @if (!string.IsNullOrWhiteSpace(source.Description))
                                                    {
                                                        <div class="source-description">

                                                            @source.Description

                                                        </div>
                                                    }


                                                    <div class="d-flex
                                                                flex-column
                                                                flex-sm-row
                                                                justify-content-between
                                                                align-items-sm-center
                                                                gap-2
                                                                mt-3">

                                                        @if (!string.IsNullOrWhiteSpace(source.PublishedAt))
                                                        {
                                                            <div class="source-date">

                                                                🕒 @source.PublishedAt

                                                            </div>
                                                        }


                                                        @if (!string.IsNullOrWhiteSpace(source.Url))
                                                        {
                                                            <a href="@source.Url"
                                                               target="_blank"
                                                               rel="noopener noreferrer"
                                                               class="btn btn-outline-primary btn-sm source-read-button">

                                                                Read Article ↗

                                                            </a>
                                                        }

                                                    </div>

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <div class="no-sources">

                                        <div class="fs-2 mb-2">
                                            🔍
                                        </div>

                                        <h6 class="fw-bold">
                                            No Similar News Sources Found
                                        </h6>

                                        <p class="mb-0 small">

                                            We could not find matching
                                            news articles from the
                                            available news search source.
                                            This does not automatically
                                            mean that the submitted news
                                            is fake.

                                        </p>

                                    </div>
                                }

                            </div>

                        </div>


                        <!-- ANALYSIS DATE -->

                        <div class="text-muted small mt-4 mb-0 analysis-date">

                            <strong>
                                Analyzed On:
                            </strong>

                            @Model.CreatedAt
                                .ToLocalTime()
                                .ToString("f")

                        </div>


                        <!-- DISCLAIMER -->

                        <div class="alert alert-warning mt-4 mb-0"
                             role="alert">

                            <strong>
                                ⚠️ Important:
                            </strong>

                            This is an AI-assisted prediction and is not
                            absolute proof that the article is true or
                            false. Important information should be
                            verified using trusted and independent
                            sources.

                        </div>

                    </div>

                </div>


                <!-- =================================
                     ACTION BUTTONS
                     ================================= -->

                <div class="action-buttons d-flex
                            flex-column
                            flex-sm-row
                            justify-content-center
                            gap-3">

                    <!-- CHECK ANOTHER NEWS -->

                    <a asp-controller="News"
                       asp-action="Check"
                       class="btn btn-primary btn-lg px-4">

                        🔍 Check Another News

                    </a>


                    <!-- DOWNLOAD PDF -->

                    <a asp-controller="News"
                       asp-action="DownloadPdf"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger btn-lg px-4 pdf-button">

                        <i class="bi bi-file-earmark-pdf me-2"></i>

                        Download PDF Report

                    </a>


                    <!-- HISTORY -->

                    <a asp-controller="News"
                       asp-action="History"
                       class="btn btn-outline-secondary btn-lg px-4">

                        🕘 View History

                    </a>

                </div>

            </div>

        </div>
    }

</div>
