<!-- =====================================================
     DARK MODE: LOAD SAVED THEME BEFORE PAGE RENDER
     ===================================================== -->
<script>
    (function () {

        const savedTheme =
            localStorage.getItem("fakeNewsTheme");

        if (savedTheme === "dark") {
            document.documentElement
                .setAttribute("data-theme", "dark");
        }
        else {
            document.documentElement
                .setAttribute("data-theme", "light");
        }

    })();
</script>


<style>

    /* =========================================
       GLOBAL MOBILE POLISH
       ========================================= */

    html,
    body {
        overflow-x: hidden;
    }


    /* =========================================
       DARK MODE - GLOBAL
       ========================================= */

    html[data-theme="dark"] {
        color-scheme: dark;
    }

    html[data-theme="dark"] body {
        background-color: #0f172a;
        color: #e2e8f0;
    }

    html[data-theme="dark"] main {
        background-color: #0f172a;
    }


    /* =========================================
       NAVBAR
       ========================================= */

    .main-navbar {
        padding-top: 0.65rem;
        padding-bottom: 0.65rem;
        transition:
            background-color 0.25s ease,
            border-color 0.25s ease;
    }

    .navbar-brand {
        min-width: 0;
    }

    .navbar-brand-text {
        white-space: nowrap;
        font-size: 1rem;
    }

    .navbar-toggler {
        padding: 0.45rem 0.65rem;
    }

    .navbar-nav .nav-link {
        border-radius: 0.5rem;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }

    .navbar-nav .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.08);
    }

    .navbar-nav .nav-link.active {
        background-color: rgba(255, 255, 255, 0.1);
    }

    .navbar-analyze-btn {
        white-space: nowrap;
    }

    .account-link {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /* =========================================
       DARK MODE TOGGLE
       ========================================= */

    .theme-toggle {
        min-width: 125px;
        border-radius: 0.6rem;
        font-weight: 600;
        transition:
            background-color 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease;
    }

    .theme-toggle-icon {
        font-size: 1rem;
        margin-right: 0.3rem;
    }


    /* =========================================
       DARK MODE NAVBAR
       ========================================= */

    html[data-theme="dark"] .main-navbar {
        background-color: #111827 !important;
        border-color: #334155 !important;
    }

    html[data-theme="dark"] .main-navbar .navbar-brand,
    html[data-theme="dark"] .main-navbar .nav-link {
        color: #e2e8f0 !important;
    }

    html[data-theme="dark"] .main-navbar .nav-link:hover,
    html[data-theme="dark"] .main-navbar .nav-link.active {
        background-color: #1e293b;
        color: #ffffff !important;
    }

    html[data-theme="dark"] .theme-toggle {
        color: #f8fafc;
        border-color: #64748b;
        background-color: #1e293b;
    }

    html[data-theme="dark"] .theme-toggle:hover {
        background-color: #334155;
        border-color: #94a3b8;
    }

    html[data-theme="dark"] .navbar-toggler {
        border-color: #64748b;
    }

    html[data-theme="dark"] .navbar-toggler-icon {
        filter: invert(1);
    }


    /* =========================================
       DARK MODE DROPDOWN
       ========================================= */

    html[data-theme="dark"] .dropdown-menu {
        background-color: #1e293b;
        border-color: #475569;
    }

    html[data-theme="dark"] .dropdown-item {
        color: #e2e8f0;
    }

    html[data-theme="dark"] .dropdown-item:hover,
    html[data-theme="dark"] .dropdown-item:focus {
        background-color: #334155;
        color: #ffffff;
    }

    html[data-theme="dark"] .dropdown-item-text {
        color: #94a3b8 !important;
    }

    html[data-theme="dark"] .dropdown-divider {
        border-color: #475569;
    }


    /* =========================================
       DARK MODE COMMON BOOTSTRAP ELEMENTS
       ========================================= */

    html[data-theme="dark"] .card {
        background-color: #1e293b;
        color: #e2e8f0;
        border-color: #334155;
    }

    html[data-theme="dark"] .bg-white {
        background-color: #1e293b !important;
    }

